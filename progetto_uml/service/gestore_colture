class GestoreColture:
    """
    Gestore della configurazione dei parametri delle colture.
    Gestisce i dati delle colture e dei parametri specifici di ogni coltura.
    """

    def __init__(self, dati_colture_source, dati_colture_utente_source):
        self.dati_colture_source = dati_colture_source
        self.dati_colture_utente_source = dati_colture_utente_source
        self.dati_colture_utente = {}

    def _leggi_dati(self, source):
        if callable(source):
            return source()
        return source or {}

    def configurazione_parametri_coltura(self, nome_coltura):
        dati = self._leggi_dati(self.dati_colture_source)
        nome_coltura = str(nome_coltura).lower().strip()
        return dati.get(nome_coltura, {
            "temperatura": 20,
            "umidita": 50
        })

    def get_tutte_colture(self):
        dati = self._leggi_dati(self.dati_colture_source)
        return list(dati.keys())

    def aggiungi_coltura_utente(self, nome_coltura, parametri):
        self.dati_colture_utente[nome_coltura] = parametri
        return True

    def get_dati_colture_utente(self):
        return self.dati_colture_utente


