from PyQt6.QtWidgets import QWidget, QVBoxLayout, QLabel, QLineEdit, QPushButton, QFrame
from PyQt6.QtCore import Qt


class SchermataRegistrazione(QWidget):

    def __init__(self, stack, auth):
        super().__init__()
        self.stack = stack
        self.auth = auth
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout()
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        card = QFrame()
        card.setFixedWidth(450)

        # FOGLIO DI STILE: Sistemati i colori dei testi per renderli leggibili sullo sfondo scuro
        card.setStyleSheet("""
            QFrame {
                background-color: rgba(255, 255, 255, 0.04);
                border-radius: 20px;
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
            QLabel {
                color: #FFFFFF;
                border: none;
                background: transparent;
            }
            QLineEdit {
                background-color: rgba(255, 255, 255, 0.06); 
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 12px; 
                padding: 12px; 
                color: #FFFFFF;
            }
            QPushButton {
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                padding: 12px;
                color: #FFFFFF;
                font-weight: 600;
            }
            QPushButton:hover {
                background-color: rgba(255, 255, 255, 0.15);
            }
        """)

        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(40, 40, 40, 40)
        card_layout.setSpacing(15)

        titolo = QLabel("REGISTRAZIONE")
        titolo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        titolo.setStyleSheet("font-size: 26px; font-weight: 700; background: transparent;")
        card_layout.addWidget(titolo)

        self.nome = QLineEdit()
        self.nome.setPlaceholderText("Nome")

        self.email = QLineEdit()
        self.email.setPlaceholderText("Email")

        self.password = QLineEdit()
        self.password.setPlaceholderText("Password")
        self.password.setEchoMode(QLineEdit.EchoMode.Password)

        self.msg = QLabel("")
        self.msg.setAlignment(Qt.AlignmentFlag.AlignCenter)

        btn_reg = QPushButton("Registra")
        btn_back = QPushButton("Indietro")

        btn_reg.clicked.connect(self.registra)
        btn_back.clicked.connect(self.torna_indietro)

        card_layout.addWidget(self.nome)
        card_layout.addWidget(self.email)
        card_layout.addWidget(self.password)
        card_layout.addWidget(self.msg)
        card_layout.addWidget(btn_reg)
        card_layout.addWidget(btn_back)

        layout.addWidget(card)
        self.setLayout(layout)

    def registra(self):
        nome = self.nome.text().strip()
        email = self.email.text().strip()
        password = self.password.text().strip()

        # Stile di default per i messaggi di errore
        self.msg.setStyleSheet("color: #FF3B30; font-weight: 600; font-size: 14px; background: transparent;")

        # ---------------- CONTROLLI BASE ----------------
        if nome == "" or email == "" or password == "":
            self.msg.setText("Compila tutti i campi")
            return

        # Controllo email
        if "@" not in email:
            self.msg.setText("Email non valida")
            return

        # FIX: Usato [-1] per estrarre l'ultimo segmento ed evitare bug con doppie chiocciole
        dominio = email.split("@")[-1]
        domini_validi = ["gmail.com", "outlook.com", "libero.it", "hotmail.com"]

        if dominio not in domini_validi:
            self.msg.setText("Dominio email non valido")
            return

        # Controllo password
        if len(password) < 6:
            self.msg.setText("Password troppo corta (min 6)")
            return

        speciali = ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "-", "_", "+", "=", "[", "]", "{", "}", "|", ";",
                    ":", ",", ".", "<", ">", "?"]

        if not any(c in speciali for c in password):
            self.msg.setText("Serve almeno un carattere speciale")
            return

        # ---------------- REGISTRAZIONE ----------------
        ok = self.auth.register_proprietario(nome, email, password)

        if ok:
            # Svuota i campi così al prossimo accesso la schermata è pulita
            self.nome.clear()
            self.email.clear()
            self.password.clear()
            self.msg.setText("")

            # Torna al login
            self.stack.setCurrentIndex(11)
        else:
            self.msg.setText("Utente già esistente")

    def torna_indietro(self):
        # Quando l'utente clicca "Indietro", puliamo la schermata da vecchi testi o errori
        self.nome.clear()
        self.email.clear()
        self.password.clear()
        self.msg.setText("")
        self.stack.setCurrentIndex(11)
