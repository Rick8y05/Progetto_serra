from PyQt6.QtWidgets import QWidget, QVBoxLayout, QLabel, QLineEdit, QPushButton, QFrame
from PyQt6.QtCore import Qt


class SchermataLogin(QWidget):
    def __init__(self, stack, auth):
        super().__init__()
        self.stack = stack
        self.auth = auth
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout()
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        card = QFrame()
        card.setFixedWidth(450)
        card.setStyleSheet("""
            QFrame { background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; }
            QLabel { color: #FFFFFF; border: none; background: transparent; }
            QLineEdit { background-color: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 12px; color: #FFFFFF; }
            QPushButton { background-color: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 12px; color: #FFFFFF; font-weight: 600; }
            QPushButton:hover { background-color: rgba(255, 255, 255, 0.15); }
        """)

        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(40, 40, 40, 40)
        card_layout.setSpacing(15)

        titolo = QLabel("LOGIN")
        titolo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        titolo.setStyleSheet("font-size: 28px; font-weight: 700;")
        card_layout.addWidget(titolo)

        self.email = QLineEdit()
        self.email.setPlaceholderText("Email")
        self.password = QLineEdit()
        self.password.setPlaceholderText("Password")
        self.password.setEchoMode(QLineEdit.EchoMode.Password)

        self.msg = QLabel("")
        self.msg.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.msg.setStyleSheet("color: #FF3B30; font-weight: 600; font-size: 14px;")

        card_layout.addWidget(self.email)
        card_layout.addWidget(self.password)
        card_layout.addWidget(self.msg)

        btn_login = QPushButton("Accedi")
        btn_reg = QPushButton("Registrati")

        btn_login.clicked.connect(self.login)
        btn_reg.clicked.connect(lambda: self.stack.setCurrentIndex(12))

        card_layout.addWidget(btn_login)
        card_layout.addWidget(btn_reg)

        layout.addWidget(card)
        self.setLayout(layout)

    def login(self):
        email = self.email.text().strip()
        password = self.password.text().strip()

        if not email or not password:
            self.msg.setText("Compila tutti i campi")
            return

        utente = self.auth.login(email, password)

        if not utente:
            self.msg.setText("Email o password non corretti")
            return

        # Salvataggio nello stack
        self.stack.utente_corrente = utente
        self.msg.setText("")

        # Pulizia campi
        self.email.clear()
        self.password.clear()

        # Scelta pagina basata sul ruolo (usa .ruolo, non l'indice)
        target_index = 0 if getattr(utente, 'ruolo', '') == "proprietario" else 8

        # Navigazione sicura
        self.stack.setCurrentIndex(target_index)

        # Aggiornamento opzionale pagina di destinazione
        pagina = self.stack.widget(target_index)
        if hasattr(pagina, "aggiorna_utente"):
            pagina.aggiorna_utente()

        print(f"Benvenuto, {getattr(utente, 'nome', 'Utente')}")
